#!/bin/sh
# Ecrit dans build.txt le numero total de commits du projet
# (commit en cours inclus). Installe via : git config core.hooksPath hooks
cd "$(git rev-parse --show-toplevel)" || exit 0
N=$(git rev-list --count HEAD 2>/dev/null) || N=0
N=$((N + 1))
printf "%d
" "$N" > build.txt
git add build.txt
